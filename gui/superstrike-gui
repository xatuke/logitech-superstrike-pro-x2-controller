#!/usr/bin/python3
"""superstrike-gui — control panel for the Logitech G PRO X 2 SUPERSTRIKE.

GTK4/libadwaita front end over libss2k.so (src/ss2k.c). All device I/O runs
on one worker thread; widgets are only touched from the GTK main loop.
"""
import ctypes
import ctypes.util
import os
import queue
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, GLib, Gtk  # noqa: E402

APP_ID = "io.github.superstrike.ControlPanel"
RATE_HZ = [125, 250, 500, 1000, 2000, 4000, 8000]
LOD_NAMES = ["Low", "Medium", "High"]           # wire values 1..3
SURFACE_NAMES = ["Auto", "On", "Off"]           # wire values 0..2
MODE_ONBOARD, MODE_HOST = 1, 2
ENODEV, EACCES, ETIMEDOUT = 19, 13, 110


# ============================================================== library binding
c_int, c_int_p = ctypes.c_int, ctypes.POINTER(ctypes.c_int)
c_u16_p = ctypes.POINTER(ctypes.c_uint16)


def _ints(*names):
    return [(n, c_int) for n in names]


class Battery(ctypes.Structure):
    _fields_ = _ints("percent", "level", "charging", "external_power")


class DpiSensor(ctypes.Structure):
    _fields_ = _ints("index", "has_y", "x_cur", "x_def", "y_cur", "y_def", "lod", "min", "max")


class HitsBtn(ctypes.Structure):
    _fields_ = _ints("actuation", "rapid", "rapid_enabled", "haptics")


class OnboardInfo(ctypes.Structure):
    _fields_ = _ints("memory_model", "profile_format", "macro_format", "profile_count",
                     "profile_count_oob", "button_count", "sector_count", "sector_size")


Sector = ctypes.c_ubyte * 256
Chunk = ctypes.c_ubyte * 16


def load_library():
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        os.environ.get("SS2K_LIB"),
        os.path.join(here, "..", "src", "libss2k.so"),
        os.path.join(here, "..", "lib", "libss2k.so"),
        ctypes.util.find_library("ss2k"),
    ]
    for path in candidates:
        if path and (os.path.exists(path) or not os.path.dirname(path)):
            try:
                lib = ctypes.CDLL(path)
                break
            except OSError:
                continue
    else:
        raise OSError("libss2k.so not found; run `make` in the project root")

    p = ctypes.c_void_p
    sigs = {
        "ss2k_new": ([], p),
        "ss2k_free": ([p], None),
        "ss2k_connect": ([p, ctypes.c_char_p], c_int),
        "ss2k_close": ([p], None),
        "ss2k_strerror": ([c_int], ctypes.c_char_p),
        "ss2k_info": ([p, c_int], ctypes.c_char_p),
        "ss2k_is_wired": ([p], c_int),
        "ss2k_get_battery": ([p, ctypes.POINTER(Battery)], c_int),
        "ss2k_charging_label": ([c_int], ctypes.c_char_p),
        "ss2k_dpi_query": ([p, c_int, ctypes.POINTER(DpiSensor)], c_int),
        "ss2k_dpi_ranges": ([p, c_int, c_int_p, c_int], c_int),
        "ss2k_dpi_set": ([p, c_int, c_int, c_int, c_int], c_int),
        "ss2k_hits_caps": ([p, c_int_p, c_int_p, c_int_p, c_int_p], c_int),
        "ss2k_hits_get": ([p, c_int, ctypes.POINTER(HitsBtn)], c_int),
        "ss2k_hits_set": ([p, c_int, c_int, c_int, c_int, c_int], c_int),
        "ss2k_rate_supported": ([p, c_u16_p], c_int),
        "ss2k_rate_get": ([p, c_int_p], c_int),
        "ss2k_rate_set": ([p, c_int], c_int),
        "ss2k_onboard_info": ([p, ctypes.POINTER(OnboardInfo)], c_int),
        "ss2k_onboard_mode_get": ([p, c_int_p], c_int),
        "ss2k_onboard_mode_set": ([p, c_int], c_int),
        "ss2k_profile_current": ([p, c_int_p], c_int),
        "ss2k_profile_activate": ([p, c_int], c_int),
        "ss2k_dpi_stage_get": ([p, c_int_p], c_int),
        "ss2k_dpi_stage_set": ([p, c_int], c_int),
        "ss2k_profile_read": ([p, c_int, Sector, c_int_p], c_int),
        "ss2k_profile_read_chunk": ([p, c_int, c_int, Chunk], c_int),
        "ss2k_sector_crc_ok": ([Sector, c_int], c_int),
        "ss2k_surface_get": ([p, c_int_p, c_int_p], c_int),
        "ss2k_surface_set": ([p, c_int], c_int),
        "ss2k_bhop_get": ([p, c_int_p], c_int),
        "ss2k_bhop_set": ([p, c_int], c_int),
    }
    for name, (args, res) in sigs.items():
        fn = getattr(lib, name)
        fn.argtypes, fn.restype = args, res
    return lib


class DeviceError(Exception):
    def __init__(self, what, rc, msg):
        super().__init__(f"{what}: {msg}")
        self.rc = rc


class Mouse:
    """Thin typed wrapper; every method runs on the worker thread."""

    def __init__(self, lib):
        self.lib = lib
        self.h = lib.ss2k_new()

    def _ck(self, rc, what):
        if rc:
            raise DeviceError(what, rc, self.lib.ss2k_strerror(rc).decode())

    def _int(self, fn, what):
        v = c_int()
        self._ck(fn(self.h, ctypes.byref(v)), what)
        return v.value

    def connect(self):
        self._ck(self.lib.ss2k_connect(self.h, None), "connect")

    def info(self, key):
        return self.lib.ss2k_info(self.h, key).decode(errors="replace")

    def battery(self):
        b = Battery()
        self._ck(self.lib.ss2k_get_battery(self.h, ctypes.byref(b)), "battery")
        return b

    def hits_count(self):
        n, a, r, h = c_int(), c_int(), c_int(), c_int()
        self._ck(self.lib.ss2k_hits_caps(self.h, *(ctypes.byref(x) for x in (n, a, r, h))), "HITS caps")
        return n.value

    def hits_get(self, btn):
        b = HitsBtn()
        self._ck(self.lib.ss2k_hits_get(self.h, btn, ctypes.byref(b)), "HITS read")
        return b

    def hits_set(self, btn, act, rt, rt_on, hap):
        self._ck(self.lib.ss2k_hits_set(self.h, btn, act, rt, rt_on, hap), "HITS write")

    def rate_mask(self):
        m = ctypes.c_uint16()
        self._ck(self.lib.ss2k_rate_supported(self.h, ctypes.byref(m)), "rate list")
        return m.value

    def rate_get(self):
        return self._int(self.lib.ss2k_rate_get, "rate read")

    def rate_set(self, idx):
        self._ck(self.lib.ss2k_rate_set(self.h, idx), "rate write")

    def dpi(self):
        s = DpiSensor()
        self._ck(self.lib.ss2k_dpi_query(self.h, 0, ctypes.byref(s)), "DPI read")
        return s

    def dpi_ranges(self):
        buf = (c_int * 96)()
        n = self.lib.ss2k_dpi_ranges(self.h, 0, buf, 32)
        if n < 0:
            self._ck(n, "DPI list")
        return [(buf[3 * i], buf[3 * i + 1], buf[3 * i + 2]) for i in range(n)]

    def dpi_set(self, dpi, lod):
        self._ck(self.lib.ss2k_dpi_set(self.h, 0, dpi, dpi, lod), "DPI write")

    def mode_get(self):
        return self._int(self.lib.ss2k_onboard_mode_get, "mode read")

    def mode_set(self, mode):
        self._ck(self.lib.ss2k_onboard_mode_set(self.h, mode), "mode write")

    def stage_get(self):
        return self._int(self.lib.ss2k_dpi_stage_get, "DPI stage read")

    def stage_set(self, stage):
        self._ck(self.lib.ss2k_dpi_stage_set(self.h, stage), "DPI stage write")

    def profile_current(self):
        return self._int(self.lib.ss2k_profile_current, "profile read")

    def profile_activate(self, sector):
        self._ck(self.lib.ss2k_profile_activate(self.h, sector), "profile activate")

    def sector(self, sector):
        buf, n = Sector(), c_int()
        self._ck(self.lib.ss2k_profile_read(self.h, sector, buf, ctypes.byref(n)), "sector read")
        return bytes(buf[: n.value]), bool(self.lib.ss2k_sector_crc_ok(buf, n.value))

    def chunk(self, sector, off):
        buf = Chunk()
        self._ck(self.lib.ss2k_profile_read_chunk(self.h, sector, off, buf), "sector read")
        return bytes(buf)

    def surface_get(self):
        m, raw = c_int(), c_int()
        self._ck(self.lib.ss2k_surface_get(self.h, ctypes.byref(m), ctypes.byref(raw)), "surface read")
        return m.value

    def surface_set(self, mode):
        self._ck(self.lib.ss2k_surface_set(self.h, mode), "surface write")

    def bhop_get(self):
        return self._int(self.lib.ss2k_bhop_get, "bunny-hop read")

    def bhop_set(self, window):
        self._ck(self.lib.ss2k_bhop_set(self.h, window), "bunny-hop write")


# ============================================================== profile decoding
def utf16_name(raw):
    chars = []
    for i in range(0, len(raw) - 1, 2):
        c = raw[i] | raw[i + 1] << 8
        if c in (0, 0xFFFF):
            break
        chars.append(chr(c))
    return "".join(chars)


def pretty_profile_name(name, slot):
    if not name or name == "PROFILE_NAME_DEFAULT":
        return f"Profile {slot}"
    return name


def button_label(e):
    if e[0] == 0xFF:
        return "Default"
    kind = e[0] & 0xF0
    if kind == 0x00:
        return "Macro"
    if kind == 0x80:
        if e[1] == 0x01:
            names = ["Left click", "Right click", "Middle click", "Back", "Forward"]
            mask = e[2] << 8 | e[3]
            hits = [names[i] if i < 5 else f"Button {i + 1}" for i in range(16) if mask >> i & 1]
            return " + ".join(hits) or "None"
        if e[1] == 0x02:
            return f"Key (usage 0x{e[3]:02x}, modifiers 0x{e[2]:02x})"
        if e[1] == 0x03:
            return f"Media key 0x{e[2] << 8 | e[3]:04x}"
        return "Disabled"
    if kind == 0x90:
        return {
            0x03: "DPI up", 0x04: "DPI down", 0x05: "DPI cycle", 0x06: "DPI default",
            0x07: "DPI shift", 0x08: "Next profile", 0x09: "Previous profile",
            0x0A: "Cycle profile", 0x0B: "G-Shift", 0x0C: "Battery status",
        }.get(e[1], f"Function 0x{e[1]:02x}")
    return "Unknown"


def decode_profile(p):
    stages = []
    for s in range(5):
        st = p[4 + 5 * s: 9 + 5 * s]
        stages.append((st[0] | st[1] << 8, st[2] | st[3] << 8, st[4]))
    buttons = []
    for i in range(16):
        e = p[0x30 + 4 * i: 0x34 + 4 * i]
        if not (e[0] == 0xFF and e[1] == 0xFF):
            buttons.append(button_label(e))
    hits = [(p[0x26 + 3 * b] >> 2, p[0x27 + 3 * b] >> 2, p[0x27 + 3 * b] & 1, p[0x28 + 3 * b] >> 2)
            for b in range(2)]
    return {
        "rate_wireless": p[0] % 7, "rate_wired": p[1] % 7,
        "default_stage": p[2], "stages": stages, "hits": hits,
        "bhop": p[0x25],
        "power_save": p[0x2C] | p[0x2D] << 8, "power_off": p[0x2E] | p[0x2F] << 8,
        "buttons": buttons, "name": utf16_name(p[0xA0:0xD0]),
    }


def read_state(m):
    """Everything the panel shows, in one worker-thread pass."""
    st = {
        "name": m.info(1), "model": m.info(2), "serial": m.info(3),
        "fw": m.info(4), "boot": m.info(5), "path": m.info(0),
        "wired": bool(m.lib.ss2k_is_wired(m.h)),
    }

    def opt(key, fn):
        try:
            st[key] = fn()
        except DeviceError as e:
            if e.rc in (-ENODEV,):
                raise
            st[key] = None

    opt("battery", m.battery)
    opt("mode", m.mode_get)
    opt("rate_mask", m.rate_mask)
    opt("rate", m.rate_get)
    opt("dpi", m.dpi)
    opt("dpi_ranges", m.dpi_ranges)
    opt("stage", m.stage_get)
    opt("surface", m.surface_get)
    opt("bhop", m.bhop_get)
    opt("hits_count", m.hits_count)
    st["hits"] = [m.hits_get(b) for b in range(st["hits_count"] or 0)]
    opt("current", m.profile_current)

    profiles = []
    try:
        directory, _ = m.sector(0)
        for i in range(0, len(directory) - 5, 4):
            e = directory[i:i + 4]
            if e[0] == 0xFF and e[1] == 0xFF:
                break
            sec = e[0] << 8 | e[1]
            raw = b"".join(m.chunk(sec, off) for off in (0xA0, 0xB0, 0xC0))
            profiles.append({"slot": i // 4 + 1, "sector": sec, "enabled": bool(e[2]),
                             "name": utf16_name(raw)})
    except DeviceError:
        pass
    st["profiles"] = profiles
    st["profile"] = None
    if st["current"]:
        try:
            data, crc_ok = m.sector(st["current"])
            st["profile"] = decode_profile(data)
            st["profile"]["crc_ok"] = crc_ok
        except DeviceError:
            pass
    return st


# ============================================================== worker
class Worker:
    """Serialises device access on one thread; callbacks land on the GTK loop."""

    def __init__(self):
        self.q = queue.Queue()
        threading.Thread(target=self._run, daemon=True).start()

    def submit(self, fn, done=None, fail=None):
        self.q.put((fn, done, fail))

    def _run(self):
        while True:
            fn, done, fail = self.q.get()
            try:
                result = fn()
            except Exception as e:  # noqa: BLE001 — surfaced to the UI
                if fail:
                    GLib.idle_add(fail, e)
                continue
            if done:
                GLib.idle_add(done, result)


# ============================================================== widgets
def scale_row(title, subtitle, lo, hi, marks=None):
    row = Adw.ActionRow(title=title, subtitle=subtitle or "")
    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
    scale.set_digits(0)
    scale.set_round_digits(0)
    scale.set_draw_value(True)
    scale.set_value_pos(Gtk.PositionType.RIGHT)
    scale.set_size_request(250, -1)
    scale.set_valign(Gtk.Align.CENTER)
    for v in range(lo, hi + 1):
        scale.add_mark(v, Gtk.PositionType.BOTTOM, (marks or {}).get(v))
    row.add_suffix(scale)
    return row, scale


def string_combo(title, subtitle, items):
    row = Adw.ComboRow(title=title, subtitle=subtitle or "")
    row.set_model(Gtk.StringList.new(items))
    return row


def battery_icon(pct, charging):
    level = max(0, min(100, int(round(pct / 10.0)) * 10))
    return f"battery-level-{level}{'-charging' if charging in (1, 2) else ''}-symbolic"


class KeyPanel:
    """Actuation / rapid trigger / haptics controls for one analog key."""

    def __init__(self, win, index, title):
        self.win, self.index = win, index
        self.group = Adw.PreferencesGroup(title=title)
        row, self.act = scale_row("Actuation point", "Travel before the click registers",
                                  1, 10, {1: "1", 10: "10"})
        self.group.add(row)
        self.rt_on = Adw.SwitchRow(title="Rapid trigger",
                                   subtitle="Re-arm on lift instead of at a fixed reset point")
        self.group.add(self.rt_on)
        row, self.rt = scale_row("Rapid trigger sensitivity", None, 1, 5, {1: "1", 5: "5"})
        self.rt_row = row
        self.group.add(row)
        row, self.hap = scale_row("Haptic feedback", "0 turns click haptics off", 0, 5,
                                  {0: "Off", 5: "5"})
        self.group.add(row)
        for w in (self.act, self.rt, self.hap):
            w.connect("value-changed", self.changed)
        self.rt_on.connect("notify::active", self.changed)

    def values(self):
        return (int(self.act.get_value()), int(self.rt.get_value()),
                int(self.rt_on.get_active()), int(self.hap.get_value()))

    def show(self, h):
        self.act.set_value(h.actuation)
        self.rt.set_value(h.rapid)
        self.rt_on.set_active(bool(h.rapid_enabled))
        self.hap.set_value(h.haptics)
        self.rt_row.set_sensitive(bool(h.rapid_enabled))

    def set_values(self, vals):
        act, rt, rt_on, hap = vals
        self.act.set_value(act)
        self.rt.set_value(rt)
        self.rt_on.set_active(bool(rt_on))
        self.hap.set_value(hap)

    def changed(self, *_):
        self.rt_row.set_sensitive(self.rt_on.get_active())
        if not self.win.loading:
            self.win.key_changed(self)


class Window(Adw.ApplicationWindow):
    def __init__(self, app, lib):
        super().__init__(application=app, title="SUPERSTRIKE")
        self.set_default_size(600, 820)
        self.worker = Worker()
        self.mouse = Mouse(lib)
        self.loading = False
        self.state = None
        self.pending = {}
        self.dpi_ranges = []
        self.retry_id = 0

        self.toasts = Adw.ToastOverlay()
        self.root = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.toasts.set_child(self.root)
        self.set_content(self.toasts)

        spinner = Adw.StatusPage(title="Looking for the mouse…")
        spinner.set_child(Adw.Spinner(width_request=32, height_request=32, halign=Gtk.Align.CENTER))
        self.root.add_named(spinner, "loading")
        self.error_page = Adw.StatusPage(icon_name="input-mouse-symbolic")
        retry = Gtk.Button(label="Try again", halign=Gtk.Align.CENTER)
        retry.add_css_class("pill")
        retry.add_css_class("suggested-action")
        retry.connect("clicked", lambda *_: self.connect_device())
        self.error_page.set_vexpand(True)
        self.error_page.set_child(retry)
        self.root.add_named(self.wrap_error(self.error_page), "error")
        self.root.add_named(self.build_main(), "main")

        self.connect_device()
        GLib.timeout_add_seconds(60, self.poll_battery)

    def wrap_error(self, page):
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        return view

    # ------------------------------------------------------------ layout
    def build_main(self):
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.stack = Adw.ViewStack()
        switcher = Adw.InlineViewSwitcher(stack=self.stack,
                                          display_mode=Adw.InlineViewSwitcherDisplayMode.LABELS)
        switcher.add_css_class("flat")
        header.set_title_widget(switcher)

        batt = Gtk.Box(spacing=4)
        self.batt_icon = Gtk.Image.new_from_icon_name("battery-missing-symbolic")
        self.batt_label = Gtk.Label(label="—")
        self.batt_label.add_css_class("numeric")
        batt.append(self.batt_icon)
        batt.append(self.batt_label)
        header.pack_start(batt)

        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Re-read everything from the mouse")
        refresh.connect("clicked", lambda *_: self.refresh())
        header.pack_end(refresh)

        view.add_top_bar(header)
        self.banner = Adw.Banner(button_label="Reconnect")
        self.banner.connect("button-clicked", lambda *_: self.connect_device())
        view.add_top_bar(self.banner)
        view.set_content(self.stack)

        self.stack.add_titled_with_icon(self.build_keys_page(), "keys", "Keys", "input-mouse-symbolic")
        self.stack.add_titled_with_icon(self.build_sensor_page(), "sensor", "Sensor", "find-location-symbolic")
        self.stack.add_titled_with_icon(self.build_profiles_page(), "profiles", "Memory", "media-flash-symbolic")
        self.stack.add_titled_with_icon(self.build_device_page(), "device", "Device", "dialog-information-symbolic")
        return view

    def build_keys_page(self):
        page = Adw.PreferencesPage()
        intro = Adw.PreferencesGroup(
            description="The main buttons are inductive analog switches (HITS). "
                        "Changes apply instantly but are not written to the stored profile, "
                        "so they reset when the mouse powers off or a profile is reloaded.")
        self.link_keys = Adw.SwitchRow(title="Same settings for both buttons")
        self.link_keys.connect("notify::active", self.on_link_keys)
        intro.add(self.link_keys)
        page.add(intro)
        self.keys = [KeyPanel(self, 0, "Left Button"), KeyPanel(self, 1, "Right Button")]
        for k in self.keys:
            page.add(k.group)
        return page

    def build_sensor_page(self):
        page = Adw.PreferencesPage()

        g = Adw.PreferencesGroup(title="Polling Rate")
        self.rate_row = Adw.ComboRow(title="Report rate")
        self.rate_row.connect("notify::selected", self.on_rate)
        g.add(self.rate_row)
        page.add(g)

        g = Adw.PreferencesGroup(title="Sensitivity")
        self.stage_row = string_combo("DPI stage", "Selects a stage of the active profile", [])
        self.stage_row.connect("notify::selected", self.on_stage)
        g.add(self.stage_row)
        self.dpi_row = Adw.SpinRow.new_with_range(100, 44000, 50)
        self.dpi_row.set_title("Live DPI")
        self.dpi_row.connect("notify::value", self.on_dpi)
        g.add(self.dpi_row)
        self.lod_row = string_combo("Lift-off distance", None, LOD_NAMES)
        self.lod_row.connect("notify::selected", self.on_dpi)
        g.add(self.lod_row)
        page.add(g)
        self.sens_group = g

        g = Adw.PreferencesGroup(title="Surface")
        self.surface_row = string_combo("Gaming surface mode", "Sensor tuning for the mouse pad", SURFACE_NAMES)
        self.surface_row.connect("notify::selected", self.on_surface)
        g.add(self.surface_row)
        page.add(g)

        g = Adw.PreferencesGroup(title="Scroll Wheel")
        self.bhop_switch = Adw.SwitchRow(title="Bunny-hop filter",
                                         subtitle="Ignore a single wheel step unless another follows in time")
        self.bhop_switch.connect("notify::active", self.on_bhop)
        g.add(self.bhop_switch)
        self.bhop_window = Adw.SpinRow.new_with_range(100, 1000, 10)
        self.bhop_window.set_title("Window (ms)")
        self.bhop_window.connect("notify::value", self.on_bhop)
        g.add(self.bhop_window)
        page.add(g)
        return page

    def build_profiles_page(self):
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(title="Control")
        self.onboard_switch = Adw.SwitchRow(
            title="Use onboard profiles",
            subtitle="Off hands control to software: live DPI works and the stored profile is not applied")
        self.onboard_switch.connect("notify::active", self.on_mode)
        g.add(self.onboard_switch)
        page.add(g)

        self.profiles_group = Adw.PreferencesGroup(title="Profiles",
                                                   description="Activating a profile reloads its stored settings.")
        page.add(self.profiles_group)
        self.profile_rows = []

        self.active_group = Adw.PreferencesGroup(title="Active Profile",
                                                 description="Read-only view of what is stored on the mouse.")
        page.add(self.active_group)
        self.active_rows = []
        return page

    def build_device_page(self):
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup()
        self.info_rows = {}
        for key, title in [("name", "Name"), ("battery", "Battery"), ("conn", "Connection"),
                           ("fw", "Firmware"), ("boot", "Bootloader"), ("model", "Model"),
                           ("serial", "Unit ID"), ("path", "Device node")]:
            row = Adw.ActionRow(title=title)
            row.add_css_class("property")
            row.set_subtitle_selectable(True)
            g.add(row)
            self.info_rows[key] = row
        page.add(g)
        return page

    # ------------------------------------------------------------ device plumbing
    def run(self, fn, done=None, what=None):
        def fail(e):
            self.report(e, what)
        self.worker.submit(fn, done, fail)

    def report(self, e, what=None):
        rc = getattr(e, "rc", 0)
        if rc in (-ENODEV, -ETIMEDOUT) or (rc > 0 and rc & 0x100):
            self.banner.set_title("The mouse is not responding — asleep or out of range?")
            self.banner.set_revealed(True)
        else:
            msg = f"{what}: {e}" if what else str(e)
            self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(msg), timeout=5))

    def connect_device(self, quiet=False):
        if self.retry_id:
            GLib.source_remove(self.retry_id)
            self.retry_id = 0
        if not quiet:
            self.root.set_visible_child_name("loading")
        self.banner.set_revealed(False)

        def work():
            self.mouse.connect()
            return read_state(self.mouse)

        def fail(e):
            rc = getattr(e, "rc", 0)
            transient = rc in (-ENODEV, -ETIMEDOUT) or (rc > 0 and rc & 0x100)
            if rc == -EACCES:
                self.error_page.set_title("Permission denied")
                self.error_page.set_description(
                    "Install the udev rule (<tt>sudo make install</tt>, then replug the receiver) "
                    "so your user can access the mouse.")
            elif rc == -ENODEV:
                self.error_page.set_title("No SUPERSTRIKE found")
                self.error_page.set_description(
                    "Plug in the LIGHTSPEED receiver or the cable. Retrying automatically…")
            elif transient:
                self.error_page.set_title("The mouse is not answering")
                self.error_page.set_description("Move it to wake it up. Retrying automatically…")
            else:
                self.error_page.set_title("Could not talk to the mouse")
                self.error_page.set_description(GLib.markup_escape_text(str(e)))
            self.root.set_visible_child_name("error")
            if transient:
                self.retry_id = GLib.timeout_add_seconds(3, self.auto_retry)

        self.worker.submit(work, self.apply_state, fail)

    def auto_retry(self):
        self.retry_id = 0
        if self.root.get_visible_child_name() == "error":
            self.connect_device(quiet=True)
        return GLib.SOURCE_REMOVE

    def refresh(self):
        self.banner.set_revealed(False)
        self.run(lambda: read_state(self.mouse), self.apply_state, "Refresh")

    def poll_battery(self):
        # silent: a sleeping mouse simply doesn't answer
        if self.state is not None and self.root.get_visible_child_name() == "main":
            self.worker.submit(self.mouse.battery, self.show_battery)
        return GLib.SOURCE_CONTINUE

    # ------------------------------------------------------------ state -> widgets
    def show_battery(self, b):
        if b is None:
            return
        label = GLib.markup_escape_text(self.mouse.lib.ss2k_charging_label(b.charging).decode())
        self.batt_icon.set_from_icon_name(battery_icon(b.percent, b.charging))
        self.batt_label.set_label(f"{b.percent}%")
        self.batt_icon.get_parent().set_tooltip_text(f"Battery {b.percent}%, {label}")
        self.info_rows["battery"].set_subtitle(f"{b.percent}% · {label}")

    def apply_state(self, st):
        self.state = st
        self.loading = True
        try:
            self._apply_state(st)
        finally:
            self.loading = False
        self.banner.set_revealed(False)
        self.root.set_visible_child_name("main")

    def _apply_state(self, st):
        self.set_title(st["name"] or "SUPERSTRIKE")
        self.show_battery(st["battery"])
        rows = self.info_rows
        rows["name"].set_subtitle(st["name"] or "—")
        rows["conn"].set_subtitle("USB cable" if st["wired"] else "LIGHTSPEED receiver")
        rows["fw"].set_subtitle(st["fw"] or "—")
        rows["boot"].set_subtitle(st["boot"] or "—")
        rows["model"].set_subtitle(st["model"] or "—")
        rows["serial"].set_subtitle(st["serial"] or "—")
        rows["path"].set_subtitle(st["path"] or "—")

        # analog keys
        hits = st["hits"]
        for k, h in zip(self.keys, hits):
            k.show(h)
            k.group.set_sensitive(True)
        for k in self.keys[len(hits):]:
            k.group.set_sensitive(False)
        if len(hits) == 2:
            same = self.keys[0].values() == self.keys[1].values()
            self.link_keys.set_active(same)

        # polling rate: only rates the current link supports
        mask = st["rate_mask"] or 0
        self.rate_choices = [i for i in range(7) if mask >> i & 1]
        self.rate_row.set_model(Gtk.StringList.new([f"{RATE_HZ[i]} Hz" for i in self.rate_choices]))
        self.rate_row.set_subtitle("Over USB cable" if st["wired"] else "Over LIGHTSPEED")
        if st["rate"] in self.rate_choices:
            self.rate_row.set_selected(self.rate_choices.index(st["rate"]))
        self.rate_row.set_sensitive(bool(self.rate_choices))

        # sensitivity
        host = st["mode"] == MODE_HOST
        prof = st["profile"]
        if prof:
            items = []
            for i, (x, y, lod) in enumerate(prof["stages"]):
                tag = " (default)" if i == prof["default_stage"] else ""
                items.append(f"Stage {i + 1} — {x} DPI{tag}" if x == y else f"Stage {i + 1} — {x}×{y} DPI{tag}")
            self.stage_row.set_model(Gtk.StringList.new(items))
            if st["stage"] is not None and 0 <= st["stage"] < len(items):
                self.stage_row.set_selected(st["stage"])
        self.stage_row.set_visible(not host and prof is not None)
        dpi = st["dpi"]
        self.dpi_ranges = st["dpi_ranges"] or []
        if dpi:
            self.dpi_row.get_adjustment().configure(dpi.x_cur, dpi.min, dpi.max, 50, 500, 0)
            if 1 <= dpi.lod <= 3:
                self.lod_row.set_selected(dpi.lod - 1)
        self.dpi_row.set_sensitive(host and dpi is not None)
        self.lod_row.set_sensitive(host and dpi is not None)
        self.dpi_row.set_subtitle("" if host else "Needs onboard profiles off (see Memory)")
        self.sens_group.set_description(
            "In onboard mode DPI comes from the profile's stages."
            if not host else "Live DPI applies immediately and is not stored.")

        if st["surface"] is not None:
            self.surface_row.set_selected(st["surface"])
        self.surface_row.set_sensitive(st["surface"] is not None)

        bhop = st["bhop"]
        self.bhop_switch.set_active(bool(bhop))
        if bhop:
            self.bhop_window.set_value(bhop * 10)
        self.bhop_window.set_sensitive(bool(bhop))

        # onboard memory
        self.onboard_switch.set_active(st["mode"] == MODE_ONBOARD)
        for r in self.profile_rows:
            self.profiles_group.remove(r)
        self.profile_rows = []
        group = None
        for p in st["profiles"]:
            row = Adw.ActionRow(title=GLib.markup_escape_text(pretty_profile_name(p["name"], p["slot"])))
            row.set_subtitle(f"Slot {p['slot']} · sector 0x{p['sector']:04x} · "
                             f"{'in the button cycle' if p['enabled'] else 'not in the button cycle'}")
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if group is None:
                group = check
            else:
                check.set_group(group)
            check.set_active(p["sector"] == st["current"])
            check.connect("toggled", self.on_profile, p["sector"])
            row.add_prefix(check)
            row.set_activatable_widget(check)
            row.set_sensitive(not host)
            self.profiles_group.add(row)
            self.profile_rows.append(row)

        for r in self.active_rows:
            self.active_group.remove(r)
        self.active_rows = []

        def add(row):
            self.active_group.add(row)
            self.active_rows.append(row)

        if prof:
            r = Adw.ActionRow(title="Report rate", subtitle=f"{RATE_HZ[prof['rate_wireless']]} Hz wireless · "
                                                             f"{RATE_HZ[prof['rate_wired']]} Hz wired")
            add(r)
            exp = Adw.ExpanderRow(title="DPI stages",
                                  subtitle=", ".join(str(x) for x, _, _ in prof["stages"]))
            for i, (x, y, lod) in enumerate(prof["stages"]):
                lodname = LOD_NAMES[lod - 1] if 1 <= lod <= 3 else "unused"
                sub = f"{x}×{y} DPI · lift-off {lodname.lower()}"
                if i == prof["default_stage"]:
                    sub += " · default"
                exp.add_row(Adw.ActionRow(title=f"Stage {i + 1}", subtitle=sub))
            add(exp)
            names = ["Left", "Right"]
            exp = Adw.ExpanderRow(title="Analog keys at power-on")
            for i, (a, rt, rt_on, hap) in enumerate(prof["hits"]):
                exp.add_row(Adw.ActionRow(
                    title=names[i],
                    subtitle=f"actuation {a} · rapid trigger {rt} ({'on' if rt_on else 'off'}) · haptics {hap}"))
            add(exp)
            exp = Adw.ExpanderRow(title="Buttons")
            for i, b in enumerate(prof["buttons"]):
                exp.add_row(Adw.ActionRow(title=f"Button {i + 1}", subtitle=GLib.markup_escape_text(b)))
            add(exp)
            add(Adw.ActionRow(title="Power saving",
                              subtitle=f"sleep after {prof['power_save']} s · off after {prof['power_off']} s"))
            add(Adw.ActionRow(title="Integrity",
                              subtitle="checksum ok" if prof["crc_ok"] else "checksum mismatch"))
        self.active_group.set_visible(prof is not None)

    # ------------------------------------------------------------ widget -> device
    def debounce(self, key, delay_ms, fn):
        old = self.pending.pop(key, None)
        if old:
            GLib.source_remove(old)

        def fire():
            self.pending.pop(key, None)
            fn()
            return GLib.SOURCE_REMOVE

        self.pending[key] = GLib.timeout_add(delay_ms, fire)

    def on_link_keys(self, *_):
        if not self.loading and self.link_keys.get_active():
            self.key_changed(self.keys[0])

    def key_changed(self, panel):
        targets = [panel]
        if self.link_keys.get_active():
            other = self.keys[1 - panel.index]
            self.loading = True
            other.set_values(panel.values())
            self.loading = False
            targets.append(other)
        for k in targets:
            vals = k.values()
            self.debounce(f"hits{k.index}", 250,
                          lambda k=k, vals=vals: self.run(lambda: self.mouse.hits_set(k.index, *vals),
                                                          what="Analog keys"))

    def on_rate(self, *_):
        if self.loading:
            return
        sel = self.rate_row.get_selected()
        if sel < len(self.rate_choices):
            idx = self.rate_choices[sel]
            self.run(lambda: self.mouse.rate_set(idx),
                     lambda _: self.toasts.add_toast(Adw.Toast(title=f"Polling at {RATE_HZ[idx]} Hz", timeout=2)),
                     "Polling rate")

    def on_stage(self, *_):
        if self.loading:
            return
        stage = self.stage_row.get_selected()
        self.run(lambda: self.mouse.stage_set(stage), what="DPI stage")

    def snap_dpi(self, v):
        best = None
        for start, end, step in self.dpi_ranges:
            if v <= start:
                cand = start
            elif v >= end:
                cand = end
            else:
                cand = start + round((v - start) / step) * step
            if best is None or abs(cand - v) < abs(best - v):
                best = cand
        return int(best if best is not None else v)

    def on_dpi(self, *_):
        if self.loading:
            return

        def fire():
            dpi = self.snap_dpi(int(self.dpi_row.get_value()))
            if dpi != int(self.dpi_row.get_value()):
                self.loading = True
                self.dpi_row.set_value(dpi)
                self.loading = False
            lod = self.lod_row.get_selected() + 1
            self.run(lambda: self.mouse.dpi_set(dpi, lod), what="DPI")

        self.debounce("dpi", 400, fire)

    def on_surface(self, *_):
        if self.loading:
            return
        mode = self.surface_row.get_selected()
        self.run(lambda: self.mouse.surface_set(mode), what="Surface mode")

    def on_bhop(self, *_):
        on = self.bhop_switch.get_active()
        self.bhop_window.set_sensitive(on)
        if self.loading:
            return
        window = int(self.bhop_window.get_value()) // 10 if on else 0
        self.debounce("bhop", 300, lambda: self.run(lambda: self.mouse.bhop_set(window), what="Bunny-hop"))

    def on_mode(self, *_):
        if self.loading:
            return
        mode = MODE_ONBOARD if self.onboard_switch.get_active() else MODE_HOST

        def work():
            self.mouse.mode_set(mode)
            return read_state(self.mouse)

        self.run(work, self.apply_state, "Onboard mode")

    def on_profile(self, check, sector):
        if self.loading or not check.get_active():
            return

        def work():
            self.mouse.profile_activate(sector)
            return read_state(self.mouse)

        self.run(work, self.apply_state, "Profile")


class App(Adw.Application):
    def __init__(self, lib):
        super().__init__(application_id=APP_ID)
        self.lib = lib

    def do_activate(self):
        win = self.get_active_window() or Window(self, self.lib)
        win.present()


def main():
    try:
        lib = load_library()
    except OSError as e:
        print(f"superstrike-gui: {e}", file=sys.stderr)
        return 1
    return App(lib).run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
