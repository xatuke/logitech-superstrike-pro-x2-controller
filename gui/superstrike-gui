        super().__init__(application=app, title="SUPERSTRIKE")
        self.set_default_size(600, 820)
        self.worker = Worker()
        self.mouse = Mouse(lib)
        self.loading = False
        self.state = None
        self.pending = {}
        self.dpi_ranges = []
        self.retry_id = 0

        self.toasts = Adw.ToastOverlay()
        self.root = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.toasts.set_child(self.root)
        self.set_content(self.toasts)

        spinner = Adw.StatusPage(title="Looking for the mouse…")
        spinner.set_child(Adw.Spinner(width_request=32, height_request=32, halign=Gtk.Align.CENTER))
        self.root.add_named(spinner, "loading")
        self.error_page = Adw.StatusPage(icon_name="input-mouse-symbolic")
        retry = Gtk.Button(label="Try again", halign=Gtk.Align.CENTER)
        retry.add_css_class("pill")
        retry.add_css_class("suggested-action")
        retry.connect("clicked", lambda *_: self.connect_device())
        self.error_page.set_vexpand(True)
        self.error_page.set_child(retry)
        self.root.add_named(self.wrap_error(self.error_page), "error")
        self.root.add_named(self.build_main(), "main")

        self.connect_device()
        GLib.timeout_add_seconds(60, self.poll_battery)

    def wrap_error(self, page):
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        return view

