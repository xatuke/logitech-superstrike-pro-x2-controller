import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, GLib, Gtk  # noqa: E402

_here = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [_here, os.path.join(_here, "..", "share", "superstrike")]
from ss2k_binding import (  # noqa: E402
    ENODEV, EACCES, ETIMEDOUT, LOD_NAMES, MODE_HOST, MODE_ONBOARD, RATE_HZ, SURFACE_NAMES,
    Mouse, Worker, autostart_enabled, load_library, pretty_profile_name,
    read_state, set_autostart, start_tray,
)

APP_ID = "io.github.superstrike.ControlPanel"

# ============================================================== widgets
def scale_row(title, subtitle, lo, hi, marks=None):
    row = Adw.ActionRow(title=title, subtitle=subtitle or "")
    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
    scale.set_digits(0)
    scale.set_round_digits(0)
    scale.set_draw_value(True)
    scale.set_value_pos(Gtk.PositionType.RIGHT)
    scale.set_size_request(250, -1)
    scale.set_valign(Gtk.Align.CENTER)
    for v in range(lo, hi + 1):
        scale.add_mark(v, Gtk.PositionType.BOTTOM, (marks or {}).get(v))
    row.add_suffix(scale)
    return row, scale


def string_combo(title, subtitle, items):
    row = Adw.ComboRow(title=title, subtitle=subtitle or "")
    row.set_model(Gtk.StringList.new(items))
    return row


def battery_icon(pct, charging):
    level = max(0, min(100, int(round(pct / 10.0)) * 10))
    return f"battery-level-{level}{'-charging' if charging in (1, 2) else ''}-symbolic"


class KeyPanel:
    """Actuation / rapid trigger / haptics controls for one analog key."""

    def __init__(self, win, index, title):
        self.win, self.index = win, index
        self.group = Adw.PreferencesGroup(title=title)
        row, self.act = scale_row("Actuation point", "Travel before the click registers",
                                  1, 10, {1: "1", 10: "10"})
        self.group.add(row)
        self.rt_on = Adw.SwitchRow(title="Rapid trigger",
                                   subtitle="Re-arm on lift instead of at a fixed reset point")
        self.group.add(self.rt_on)
        row, self.rt = scale_row("Rapid trigger sensitivity", None, 1, 5, {1: "1", 5: "5"})
        self.rt_row = row
        self.group.add(row)
        row, self.hap = scale_row("Haptic feedback", "0 turns click haptics off", 0, 5,
                                  {0: "Off", 5: "5"})
        self.group.add(row)
        for w in (self.act, self.rt, self.hap):
            w.connect("value-changed", self.changed)
        self.rt_on.connect("notify::active", self.changed)

    def values(self):
        return (int(self.act.get_value()), int(self.rt.get_value()),
                int(self.rt_on.get_active()), int(self.hap.get_value()))

    def show(self, h):
        self.act.set_value(h.actuation)
        self.rt.set_value(h.rapid)
        self.rt_on.set_active(bool(h.rapid_enabled))
        self.hap.set_value(h.haptics)
        self.rt_row.set_sensitive(bool(h.rapid_enabled))

    def set_values(self, vals):
        act, rt, rt_on, hap = vals
        self.act.set_value(act)
        self.rt.set_value(rt)
        self.rt_on.set_active(bool(rt_on))
        self.hap.set_value(hap)

    def changed(self, *_):
        self.rt_row.set_sensitive(self.rt_on.get_active())
        if not self.win.loading:
            self.win.key_changed(self)


